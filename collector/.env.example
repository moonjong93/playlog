# ---- 저장소 ----
# 경로는 비워둔다 → settings.py 가 collector/ 기준 상대경로로 계산한다.
# (기계마다 절대경로가 다르면 .env 하나로 Mac/N100 둘 다 못 쓴다)
# COLLECTOR_DB=./data/news.db
# SOURCES_FILE=./config/sources.yaml
# NOISE_RULES=./config/noise_rules.yaml

# ---- 수집 ----
COLLECT_INTERVAL=900
FETCH_TIMEOUT=20
NEWS_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0.0.0 Safari/537.36
REDDIT_COMMENT_POSTS=2
REDDIT_SLEEP=8
REDDIT_MIN_INTERVAL=3600
# reddit.com/prefs/feeds 에서 아무 RSS URL 의 user= / feed= 값을 복사한다.
# upvoted 피드 자체를 소스로 쓰지 말고, r/Games 같은 공개 .rss 에 파라미터만 붙인다.
REDDIT_USER=
REDDIT_FEED=

# ---- 임베딩 ----
# provider=local → sentence-transformers 를 프로세스 안에서 돌린다(HF 자동 다운로드).
#   설치: uv sync --extra local-embed
# provider=openrouter → HTTP. 테스트/임시용. EMBED_API_KEY 필요.
EMBED_PROVIDER=local
EMBED_LOCAL_MODEL=LiquidAI/LFM2.5-Embedding-350M
EMBED_DEVICE=cpu
# float32 = 빠름(2.4GB RSS) / bfloat16 = 느림(1.0GB RSS). 4GB 장비면 bfloat16.
# 실측(M2, 64건): float32 24.6건/s 2413MB, bfloat16 9.0건/s 1033MB
EMBED_DTYPE=bfloat16
EMBED_PROMPT=document
EMBED_BATCH=32
EMBED_MAX_CHARS=400
# openrouter 전용
EMBED_BASE_URL=https://openrouter.ai/api/v1
EMBED_API_KEY=
EMBED_TIMEOUT=120

# 같은 사건으로 묶을 코사인 유사도 기준(리포트 지표). 모델을 바꾸면 재보정한다.
SIM_THRESHOLD=0.72
