[Unit]
Description=writer — 수집본 RAG + OpenRouter 한글 기사 (3시간 주기)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# 리포를 ~/playlog 에 클론했다고 가정한다. 경로가 다르면 수정할 것.
WorkingDirectory=%h/playlog/writer
ExecStart=%h/playlog/writer/.venv/bin/writer run --interval 10800
Restart=always
RestartSec=30
Nice=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
