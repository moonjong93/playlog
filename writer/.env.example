# 경로는 비워둔다 → settings.py 가 writer/ 기준으로 계산한다.
# NEWS_DB 기본값: ../collector/data/news.db (collector 와 같은 파일)
# NEWS_DB=../collector/data/news.db
# PROMPTS_FILE=./config/prompts.yaml
# WRITER_OUT=./out

# collector 가 넣은 벡터의 DB 키. 로컬 임베딩 기본값과 같아야 한다.
EMBED_MODEL=lfm2.5-embedding-350m

# ---- 주기 / 창 ----
WRITER_INTERVAL=10800
WRITER_BATCH=100
RAG_WINDOW_HOURS=168
MERGE_DAYS=14
# WEB_URL=http://127.0.0.1:8787
# WEB_API_KEY=dev-key

# ---- 유사도 (collector SIM_THRESHOLD 와 맞출 것) ----
SIM_THRESHOLD=0.72
RAG_ARTICLE_MIN=0.65
RAG_COMMUNITY_MIN=0.58
MERGE_FOLLOWUP=0.80
MERGE_RELATED=0.70
RAG_ARTICLE_K=8
RAG_COMMUNITY_K=3
MIN_SINGLETON_DESC=200
MIN_SINGLETON_WEIGHT=1.5

# ---- OpenRouter chat (임베딩이 아님) ----
OPENROUTER_BASE=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
WRITER_MODEL=openai/gpt-5.6-luna
# EDITOR_MODEL 은 쓰지 않는다. 스토리당 OpenRouter 한 번.
# 모델 경합. `uv run writer bench` 또는 `uv run writer batch` 가 이 목록을 쓴다.
BENCH_MODELS=inclusionai/ling-3.0-flash,deepseek/deepseek-v4-flash,google/gemma-4-26b-a4b-it,google/gemma-4-31b-it,upstage/solar-pro4,google/gemini-2.5-flash-lite,openai/gpt-5.6-luna
WRITER_MAX_TOKENS=10000
WRITER_TIMEOUT=180
WRITER_MIN_INTERVAL=0.5
WRITER_TEMPERATURE=0.3
