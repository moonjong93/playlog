# news-web 배포용 env. infra/env/news-web.env (600) 로 복사해서 쓴다.
# writer(core)와 WEB_API_KEY 를 공유한다. SESSION_SECRET 은 `openssl rand -hex 32`.

WEB_API_KEY=
SESSION_SECRET=

# 아래는 컨테이너 값으로 고정한다(로컬 dev 설정이 섞이지 않게).
PORT=8787
HOST=0.0.0.0
WEB_DB=/app/data/web.db
TRUST_PROXY=cloudflare
COOKIE_SECURE=1
RATE_LIMIT_DISABLED=0
SITE_URL=https://news.nevra.app

# 검색엔진 소유확인(선택)
GOOGLE_SITE_VERIFICATION=
NAVER_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
