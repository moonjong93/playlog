[Unit]
Description=playlog collector — RSS/Reddit 수집 + 노이즈 + 임베딩 (15분 주기)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/playlog/collector
ExecStart=%h/playlog/collector/.venv/bin/collector run --interval 900
Restart=always
RestartSec=30
Nice=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
