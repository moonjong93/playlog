# news 환경변수 예시 — 루트에서 `cp .env.example .env` 후 값만 채운다.
#
# 읽는 주체
#   - docker compose (web + cloudflared): 루트 .env 를 자동으로 읽는다
#   - collector / writer / web: 프로젝트 .env → 루트 .env 순으로 읽는다(프로젝트 .env 우선)
# 따라서 app LXC 에서는 이 파일 하나만 있으면 되고,
# dev 에서는 각 프로젝트 .env 로 값을 덮어쓸 수 있다.
#
# 포트: 공개 서비스는 루트 compose 기준 loopback 127.0.0.1:${WEB_PORT} 만 연다.
#       외부 유입은 cloudflared 터널뿐이다. collector/writer 는 포트를 열지 않는다.

# ── 도메인 / 포트 ────────────────────────────────────────
SITE_URL=https://news.nevra.app
WEB_PORT=8787

# ── Cloudflare Tunnel ───────────────────────────────────
# Zero Trust → Networks → Tunnels 에서 터널 생성 후 토큰 복사.
# Public hostname 등록: news.nevra.app → http://news-web:8787
CLOUDFLARE_TUNNEL_TOKEN=

# ── web (공개) ──────────────────────────────────────────
# WEB_API_KEY 는 writer 와 공유한다(같은 값). 회전하면 writer 도 같이 바꿔야 발행이 안 끊긴다.
# SESSION_SECRET 생성: openssl rand -hex 32
WEB_API_KEY=
SESSION_SECRET=

# ── OpenRouter (임베딩 = 수집, 생성 = writer) ───────────
# 비우면 기동/발행이 실패한다.
OPENROUTER_API_KEY=
OPENROUTER_BASE=https://openrouter.ai/api/v1

# ── collector ───────────────────────────────────────────
# 기본: OpenRouter 무료 임베딩(로컬 torch 불필요).
EMBED_PROVIDER=openrouter
EMBED_MODEL=liquid/lfm-2.5-embedding-350m:free
EMBED_DTYPE=bfloat16
SIM_THRESHOLD=0.72

COLLECT_INTERVAL=900
FETCH_TIMEOUT=20

# Reddit: prefs/feeds 의 user=/feed= 토큰. 비우면 익명(1 req/min).
REDDIT_USER=
REDDIT_FEED=
REDDIT_COMMENT_POSTS=8
REDDIT_SLEEP=8
REDDIT_MIN_INTERVAL=3600

# 나중에 ai LXC 로컬 임베딩으로 전환할 때:
#   EMBED_BASE_URL=http://<ai-IP>:8000/v1
#   EMBED_MODEL=lfm2.5-embedding-350m
#   EMBED_API_KEY=dummy
# 전환 후 `collector embed --rebuild --purge` 로 벡터를 다시 만든다.

# ── writer ──────────────────────────────────────────────
WRITER_MODEL=deepseek/deepseek-v4-flash-0731
WRITER_MAX_TOKENS=64000
WRITER_TEMPERATURE=0.3
WRITER_INTERVAL=10800
WRITER_BATCH=100
WRITER_TIMEOUT=180
WRITER_MIN_INTERVAL=0.5
BENCH_MODELS=deepseek/deepseek-v4-flash-0731,deepseek/deepseek-v4.1-flash,openai/gpt-5.6-luna,google/gemma-4-31b-it,upstage/solar-pro4

# 유사도/창 (collector SIM_THRESHOLD 와 맞출 것)
RAG_WINDOW_HOURS=168
MERGE_DAYS=14
RAG_ARTICLE_MIN=0.65
RAG_COMMUNITY_MIN=0.50
MERGE_FOLLOWUP=0.80
MERGE_RELATED=0.70
RAG_ARTICLE_K=8
RAG_COMMUNITY_K=3
MIN_SINGLETON_DESC=200
MIN_SINGLETON_WEIGHT=1.5

# writer → web 발행 주소 (compose 가 loopback 으로 열어준다)
WEB_URL=http://127.0.0.1:8787
