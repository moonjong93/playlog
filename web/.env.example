# web 환경변수. 로컬이든 docker compose 든 이 파일을 복사해서 쓴다.
#   cp .env.example .env
# compose 는 같은 디렉터리의 .env 를 자동으로 읽어 ${...} 자리를 채운다.

# /internal/* 발행(Bearer) 키. writer 와 같은 값을 공유한다. (필수)
WEB_API_KEY=dev-key

# 세션 쿠키 HMAC 키. 비어 있으면 기동 실패. (필수)
# 생성: openssl rand -hex 32
SESSION_SECRET=

# HTTP 포트. 기본 8787
PORT=8787

# 바인드 주소. 터널을 붙일 땐 127.0.0.1 유지.
# (컨테이너 안에서는 compose 가 0.0.0.0 으로 덮어쓴다)
HOST=127.0.0.1

# SQLite 파일 경로. 테스트 격리에도 쓴다.
# (컨테이너에서는 /app/data/web.db)
WEB_DB=./data/web.db

# cloudflare 로 설정하면 CF-Connecting-IP 를 실제 방문자 IP 로 신뢰한다.
# Cloudflare Tunnel 뒤에서만 켠다. 직접 노출이면 비워둔다.
TRUST_PROXY=

# OG/RSS/sitemap/canonical 의 절대 URL 기준. 비우면 요청 Host(origin)를 쓴다.
# 운영에서는 도메인을 고정하려면 채워 둔다. 예: https://news.example.com
SITE_URL=

# 1이면 세션 쿠키에 Secure 를 붙인다. HTTPS 뒤에서만 1.
COOKIE_SECURE=0

# 1이면 레이트 리밋 해제(부하 테스트용). 운영에서는 0.
RATE_LIMIT_DISABLED=0
